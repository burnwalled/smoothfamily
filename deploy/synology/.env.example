# Production settings for Smooth Family on Synology.
# Written by install.sh – you shouldn't need to edit it. Everything about the
# family itself (name, admin e-mail, sign-in security) is chosen on the setup page.

# Image tag loaded from images.tar.gz (set by install.sh from VERSION)
APP_VERSION=

# Public address, e.g. family.example.com – a CNAME to your DDNS name (e.g. yourname.myds.me).
# The HTTPS certificate (Let's Encrypt) and passkeys are bound to it.
DOMAIN=

# Generated by install.sh – keep a copy somewhere safe (password manager)
SECRET_KEY=
POSTGRES_PASSWORD=
# Needed once, when creating the family on the start page
SETUP_CODE=
# The recipe search's own search engine (SearXNG)
SEARXNG_SECRET=

# All persistent data (database, photos, certificates, backups).
# install.sh sets it to the data/ folder next to this file, whichever volume that is.
DATA_DIR=

# NAS port Caddy listens on; forward WAN 443 -> NAS:8443 in the router
HTTPS_PORT=8443
