# --- Database ---
DATABASE_URL=postgresql+asyncpg://boet:boet@localhost:5432/boet

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Clerk auth ---
# Hämta från https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# JWT-issuer för validering
CLERK_JWT_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev

# --- Stripe ---
# Hämta från https://dashboard.stripe.com/apikeys (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs som du skapar i Stripe Dashboard
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_STANDARD_YEARLY=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=Boet <noreply@boet.se>

# --- Sentry ---
SENTRY_DSN=https://...@sentry.io/...

# --- Encryption ---
# Generera med: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- App ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO
