# Copy to .env and fill in. scripts/install.sh does this for you.

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# The recipe search's own search engine (SearXNG). Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# The port the app is reached on inside the home network (http://<pi-ip>:PORT)
PORT=3000

# Data location on host (defaults to ./data). Use a USB SSD path on Pi.
DATA_DIR=./data

# Set to true if you run behind a reverse proxy with TLS (recommended)
COOKIE_SECURE=false

# Media storage (Phase C): local filesystem only
STORAGE_PROVIDER=local
MEDIA_ROOT=/data/media

# Optional off-site backup sidecar (compose profile: backup-sync)
# MUST point to an rclone crypt remote, e.g. mycrypt:smooth-family
RCLONE_REMOTE=
RCLONE_SYNC_INTERVAL_SECONDS=86400
