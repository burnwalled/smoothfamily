{
  "name": "Smooth Family",
  "short_name": "Smooth",
  "description": "Your family's own portal — runs in your home, not in the cloud.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F2F1EC",
  "theme_color": "#1E3328",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
